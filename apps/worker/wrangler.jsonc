{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reader",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/public/*"]
  },
  "r2_buckets": [
    {
      "binding": "Library",
      "bucket_name": "reader"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },

  "previews": {
    "r2_buckets": [
      {
        "binding": "Library",
        "bucket_name": "reader"
      }
    ]
  }
}
