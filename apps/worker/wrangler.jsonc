{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booklore",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOOKLORE",
      "bucket_name": "booklore"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
}
